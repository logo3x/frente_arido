<?xml version="1.0" encoding="UTF-8"?>
<!--
  Frente Árido en IIS. El sitio de IIS apunta a la carpeta public/.
  Requisitos: módulo URL Rewrite, Application Request Routing (ARR) con el proxy habilitado,
  la característica «Protocolo WebSocket» de IIS y PHP por FastCGI. Ver despliegue/iis/GUIA-IIS.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Todo el sitio por HTTPS: la cookie de sesión lleva la marca secure y por http el navegador la descarta (error 419 al registrarse o entrar).
             Se exceptúan la validación del certificado (win-acme) y las pruebas en el propio servidor. -->
        <rule name="Redirigir a HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^(localhost|127\.0\.0\.1)(:\d+)?$" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Servidor de partidas (Node.js en 127.0.0.1:8080): wss://dominio/ws se reenvía por ARR con WebSocket -->
        <rule name="Servidor de partidas" stopProcessing="true">
          <match url="^ws(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8080{R:1}" />
        </rule>
        <!-- El validador de misiones y la salud del servidor de partidas no se publican: Laravel los llama por 127.0.0.1 -->
        <rule name="Bloquear validador" stopProcessing="true">
          <match url="^(validar-mision|health)$" />
          <action type="CustomResponse" statusCode="404" statusReason="No encontrado" statusDescription="No encontrado" />
        </rule>
        <!-- Barra final: redirige /ruta/ a /ruta salvo en carpetas reales (por ejemplo /juego/) -->
        <rule name="Quitar barra final" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <!-- Laravel: todo lo que no sea un archivo o carpeta real pasa por index.php -->
        <rule name="Laravel" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Tipos de archivo del juego que IIS no trae por defecto -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".ogg" />
      <mimeMap fileExtension=".ogg" mimeType="audio/ogg" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <security>
      <requestFiltering>
        <!-- Nunca servir archivos ocultos ni de configuración -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>

  <!--
    Cliente del juego (archivos estáticos): misma política de seguridad que en el resto del proyecto,
    sin scripts en línea. 'self' en connect-src incluye wss:// del mismo dominio.
  -->
  <location path="juego">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
        </customHeaders>
      </httpProtocol>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.01:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
